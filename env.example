# --- S3 (CESNET Object Storage) ---
# Documentation: https://docs.du.cesnet.cz/en/docs/object-storage-s3/s3-service
S3_ENDPOINT=https://s3.example.du.cesnet.cz
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_BUCKET=your-test-bucket

# --- EOSC CZ / NRP (Invenio) ---
# Documentation: https://data.narodni-repozitar.cz/
NRP_BASE=https://data.narodni-repozitar.cz
NRP_TOKEN=REPLACE_ME

# --- OpenStack API ---
# Documentation: https://docs.platforms.cloud.e-infra.cz/en/docs/technical-reference/brno-g2-site
OS_AUTH_URL=https://identity.brno2.cloud.e-infra.cz:5000/v3
OS_REGION_NAME=brno2-cerit
OS_APPLICATION_CREDENTIAL_ID=REPLACE_ME
OS_APPLICATION_CREDENTIAL_SECRET=REPLACE_ME

# --- Open WebUI Chat API ---
# Documentation: https://docs.cerit-sc.cz/en/docs/web-apps/chat-ai
EINFRA_AI_BASE_URL=https://llm.ai.e-infra.cz/v1
EINFRA_AI_TOKEN=REPLACE_ME

# --- GPU/Container demo ---
CONTAINER_RUNTIME=apptainer
CONTAINER_IMAGE=/path/to/image.sif
